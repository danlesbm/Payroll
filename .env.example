NODE_ENV=production
PORT=3102
# docker compose tự đặt DATABASE_URL; chỉ cần khi chạy node trực tiếp
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5433/sbm_payroll
POSTGRES_PASSWORD=CHANGE_ME

# ===== SSO Portal (KHÔNG sửa SSO) =====
# Địa chỉ SSO mà CONTAINER payroll gọi được
SSO_BASE_URL=https://ssotest.sbm.com.vn
# PHẢI TRÙNG với SSO_INTERNAL_API_SECRET trong .env của SSO (để đọc danh bạ nhân sự/phòng ban/chức vụ)
SSO_INTERNAL_API_SECRET=PUT_THE_SAME_SECRET_AS_SSO

# Người có vai trò admin trong SSO tự động là Quản trị Payroll (đặt false để tắt)
SSO_ADMIN_IS_ADMIN=true
# Quản trị Payroll cấp riêng theo email (cách nhau dấu phẩy)
PAYROLL_BOOTSTRAP_EMAILS=danle.sbm@gmail.com

# Tự đồng bộ danh bạ SSO mỗi N phút (0 = tắt; vẫn đồng bộ lúc khởi động và khi bấm nút)
SYNC_INTERVAL_MIN=30
# Các nguồn được phép nhúng iframe Payroll
FRAME_ANCESTORS='self' https://*.sbm.com.vn
# Schema Postgres mới, tách khỏi bảng cũ ở schema public (không xoá dữ liệu cũ)
DB_SCHEMA=payroll_v1
